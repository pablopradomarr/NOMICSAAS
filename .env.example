PORT=7331
SELF_HOSTED_MODE=true
DISABLE_SIGNUP=true

# Required when using docker-compose.build.yml — set a strong, unique password.
# The same value is used in DATABASE_URL, so update both together.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
POSTGRES_DB="taxhacker"

UPLOAD_PATH="./data/uploads"

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos (ADR-0002 + ADR-0007)
#
# DATABASE_URL  → rol de RUNTIME `app_runtime`: LOGIN, NOBYPASSRLS y NO
#                 propietario de las tablas. Es lo que hace efectiva la barrera 2
#                 (RLS): si la app conectara como propietario, las políticas se
#                 ignorarían (salvo FORCE, que ya está activo) y el aislamiento
#                 dependería sólo de `tenantDb`.
# DIRECT_URL    → rol PROPIETARIO, sólo para `prisma migrate` (crear tablas,
#                 políticas y funciones). Nunca lo usa el servidor web.
#
# En Supabase: DATABASE_URL apunta al pooler con `app_runtime`; DIRECT_URL a la
# conexión directa con el rol de servicio.
# ─────────────────────────────────────────────────────────────────────────────
# La contraseña de `app_runtime` NO la fija ninguna migración (quedaría en el
# repositorio): la crea el operador. En local/CI, `./scripts/dev-db-setup.sh`
# la establece a partir de esta variable.
APP_RUNTIME_PASSWORD="change-me-app-runtime-password"
DATABASE_URL="postgresql://app_runtime:change-me-app-runtime-password@localhost:5432/taxhacker"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/taxhacker"

# You can put it here or the app will ask you to enter it
OPENAI_MODEL_NAME="gpt-4o-mini"
OPENAI_API_KEY=""  # "sk-..."

GOOGLE_MODEL_NAME="gemini-2.5-flash"
GOOGLE_API_KEY=""

MISTRAL_MODEL_NAME="mistral-medium-latest"
MISTRAL_API_KEY=""

# Auth Config
# Recommended everywhere. In self-hosted Docker, TaxHacker can auto-generate and persist one if omitted.
BETTER_AUTH_SECRET="random-secret-key"  # please use any long random string here

# Stripe Configuration
STRIPE_SECRET_KEY=""  # "sk_live_..." or "sk_test_..."
STRIPE_WEBHOOK_SECRET=""  # "whsec_..."

# Resend Configuration (optional, use if you want to send emails)
RESEND_API_KEY=""  # "re_..."
RESEND_AUDIENCE_ID=""  # "aud_..."
RESEND_FROM_EMAIL="TaxHacker <user@localhost>"
