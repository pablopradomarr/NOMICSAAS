PORT=7331
SELF_HOSTED_MODE=true
DISABLE_SIGNUP=true

# Required when using docker-compose.build.yml — set a strong, unique password.
# The same value is used in DATABASE_URL, so update both together.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
POSTGRES_DB="taxhacker"

UPLOAD_PATH="./data/uploads"

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos (ADR-0002 + ADR-0007)
#
# DATABASE_URL  → rol de RUNTIME `app_runtime`: LOGIN, NOBYPASSRLS y NO
#                 propietario de las tablas. Es lo que hace efectiva la barrera 2
#                 (RLS): si la app conectara como propietario, las políticas se
#                 ignorarían (salvo FORCE, que ya está activo) y el aislamiento
#                 dependería sólo de `tenantDb`.
# DIRECT_URL    → rol PROPIETARIO, sólo para `prisma migrate` (crear tablas,
#                 políticas y funciones). Nunca lo usa el servidor web.
#
# En Supabase: DATABASE_URL apunta al pooler con `app_runtime`; DIRECT_URL a la
# conexión directa con el rol de servicio.
# ─────────────────────────────────────────────────────────────────────────────
# La contraseña de `app_runtime` NO la fija ninguna migración (quedaría en el
# repositorio): la crea el operador. En local/CI, `./scripts/dev-db-setup.sh`
# la establece a partir de esta variable.
APP_RUNTIME_PASSWORD="change-me-app-runtime-password"
DATABASE_URL="postgresql://app_runtime:change-me-app-runtime-password@localhost:5432/taxhacker"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/taxhacker"

# AUTH_DATABASE_URL → rol `app_auth` (E7 · T14, ADR-0015 D5).
#
# `users` lleva RLS desde `20260916130000_e7_users_rls`, con políticas POR ROL:
# `app_runtime` sólo ve su propia fila y la de quien comparte la organización
# activa, y no puede dar de alta ni borrar; el camino de autenticación (alta,
# OTP, verificación, sesión) necesita leer y escribir SIN sesión y lo hace con
# este rol, que tiene privilegio sobre CUATRO tablas —users, sessions, account,
# verification— y sobre ninguna más. Es `NOBYPASSRLS`: darle `BYPASSRLS` habría
# reabierto el agujero que ADR-0009 cerró.
#
# Sin esta variable la aplicación arranca y AVISA, pero el alta de un usuario
# fallará con «permission denied» en cuanto `DATABASE_URL` sea `app_runtime` de
# verdad. La contraseña la fija el operador (en local, ./scripts/dev-db-setup.sh).
APP_AUTH_PASSWORD="change-me-app-auth-password"
AUTH_DATABASE_URL="postgresql://app_auth:change-me-app-auth-password@localhost:5432/taxhacker"

# ─────────────────────────────────────────────────────────────────────────────
# Pool de conexiones (E6-perf, `poolConfig()` en lib/db.ts)
#
# `pg` trae `max: 10`. Con una transacción por operación (deuda ya cerrada) un
# solo render podía pedir diez conexiones a la vez y la petición siguiente moría
# con «Transaction API error: Unable to start a transaction in the given time».
# Hoy cada petición usa UNA sola conexión (`runWithRequestTenant` /
# `tenantPage`), así que estos valores son cabecera, no cuello de botella.
#
# DB_POOL_MAX                    conexiones simultáneas del proceso. 20 por
#                                defecto; en Supabase, ≤ lo que permita el
#                                pooler dividido entre las instancias.
# DB_POOL_IDLE_TIMEOUT_MS        cierra la conexión ociosa (10 000 por defecto).
# DB_POOL_CONNECTION_TIMEOUT_MS  espera máxima por una conexión libre antes de
#                                fallar con un error claro (10 000 por defecto).
# ─────────────────────────────────────────────────────────────────────────────
DB_POOL_MAX="20"
DB_POOL_IDLE_TIMEOUT_MS="10000"
DB_POOL_CONNECTION_TIMEOUT_MS="10000"

# DATABASE_URL_MAINTENANCE → rol `app_maintenance` (BYPASSRLS), ADR-0009 §6.
#
# Desde E3 la RLS es ESTRICTA: sin `app.current_org` fijado no se ve NADA. Lo que
# legítimamente necesita recorrer TODAS las organizaciones —los scripts de
# operador (`scripts/migrate-uploads-to-org.ts`) y el check del invariante I10
# (`scripts/run-invariants.ts`), que sólo puede detectar un cruce entre
# organizaciones consultando sin filtro de tenant— usa este rol, con credencial
# propia y auditable, en lugar de un agujero en la política.
#
# NO la pongas en el entorno del servidor web: la aplicación nunca conecta con
# este rol. Déjala vacía salvo en el contenedor donde se ejecuten esos scripts.
# En local/CI la crea `./scripts/dev-db-setup.sh` a partir de esta variable.
APP_MAINTENANCE_PASSWORD="change-me-app-maintenance-password"
DATABASE_URL_MAINTENANCE=""

# You can put it here or the app will ask you to enter it
OPENAI_MODEL_NAME="gpt-4o-mini"
OPENAI_API_KEY=""  # "sk-..."

GOOGLE_MODEL_NAME="gemini-2.5-flash"
GOOGLE_API_KEY=""

MISTRAL_MODEL_NAME="mistral-medium-latest"
MISTRAL_API_KEY=""

# Auth Config
# Recommended everywhere. In self-hosted Docker, TaxHacker can auto-generate and persist one if omitted.
BETTER_AUTH_SECRET="random-secret-key"  # please use any long random string here

# E13 · T1 — duración de la sesión en días (docs/design/E13-autenticacion.md §4.1, D-1). Por defecto 30.
AUTH_SESSION_DAYS="30"

# Stripe Configuration
STRIPE_SECRET_KEY=""  # "sk_live_..." or "sk_test_..."
STRIPE_WEBHOOK_SECRET=""  # "whsec_..."

# Resend Configuration (optional, use if you want to send emails)
RESEND_API_KEY=""  # "re_..."
RESEND_AUDIENCE_ID=""  # "aud_..."
RESEND_FROM_EMAIL="TaxHacker <user@localhost>"

# ─────────────────────────────────────────────────────────────────────────────
# E11 · Plataforma SaaS (docs/design/E11-plataforma-saas.md §9.1, ADR-0019)
#
# Los secretos de plataforma viven en el ENTORNO, nunca en la base de datos. Los
# secretos POR ORGANIZACIÓN (IMAP) siguen cifrados con `lib/encryption.ts`
# (AES-256-GCM + scrypt de BETTER_AUTH_SECRET).
#
# AVISO · desde E11, arrancar con SELF_HOSTED_MODE=false y el BETTER_AUTH_SECRET
# de ejemplo FALLA al arrancar: de esa clave deriva el cifrado de los secretos
# por organización, y con el valor por defecto no hay cifrado, sólo apariencia
# de cifrado.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# MODO DE FACTURACIÓN (ADR-0019 **D9**, aprobado por Pablo el 2026-09-15)
#
# `none` es el modo INTERNO y **el valor por defecto**: el producto es de uso
# interno y NO se cobra. Significa, literalmente:
#
#   · sin Stripe — `/api/stripe/*` responde **404** y no hace falta ninguna clave;
#   · toda organización nace con el plan **ILIMITADO** (los siete límites a -1);
#   · **`READ_ONLY` por impago NUNCA**: donde no hay precio no puede haber mora;
#   · no se emite ninguna factura de plataforma (art. 4.Uno LIVA: sin
#     contraprestación no hay operación sujeta, y una factura a cero ensucia la
#     serie sin documentar nada);
#   · `/settings/subscription` enseña «Modo interno: sin facturación», el plan y
#     el uso, sin portal ni facturas.
#
# `stripe` enciende D1…D8 tal cual. El defecto es el seguro: una instalación que
# se olvide de configurarlo **no cobra**, en vez de cobrar mal.
BILLING_PROVIDER="none"

# Quién puede cambiar el plan de una organización (D9.4), separados por comas.
# Es la ÚNICA forma de cambiar de plan en modo interno, y hace falta que la haya:
# sin ella los límites no se pueden ejercitar. Cada cambio queda en
# `platform_audit_logs` (`plan.changed`) y en el AuditLog de la organización.
#
# Vacía en modo interno = el ADMIN de la organización (quien opera y quien
# administra son la misma persona). Vacía en modo `stripe` = NADIE: allí el plan
# se cambia en el portal, que es donde están la tarjeta y los datos fiscales.
ADMIN_CONFIRMATION_SECRET=""  # opcional: firma los tokens de /admin. Sin ella se DERIVA de BETTER_AUTH_SECRET (HKDF)
PLATFORM_ADMIN_EMAILS=""

# Reloj (§7.2). Protege `POST /api/cron/[job]` con comparación en tiempo
# constante. **Vacío = la ruta responde 401 a todo**: cerrada por defecto, nunca
# abierta «porque no hay secreto». Mismo valor en el despliegue y en el secreto
# `CRON_SECRET` del repositorio de GitHub (.github/workflows/cron.yml).
CRON_SECRET=""

# Firma del manifest del backup (§5.2, HMAC-SHA256). Lo consume la ola B.
# `PLATFORM_SIGNING_KEY_ID` viaja en el manifest para poder ROTAR: al rotar, se
# mueve la clave vigente a `_PREVIOUS` y `verifyManifest` acepta las dos.
PLATFORM_SIGNING_KEY=""
PLATFORM_SIGNING_KEY_ID="k1"
PLATFORM_SIGNING_KEY_PREVIOUS=""

# Almacén de objetos (§4, ADR-0019 D3, P-3). `local` en desarrollo y
# self-hosted; `s3` en cloud — Supabase Storage se consume por su endpoint S3,
# así que hay UN solo driver de red. **Un bucket por ENTORNO con prefijo por
# organización**, no un bucket por organización.
STORAGE_BACKEND="local"
STORAGE_BUCKET=""
STORAGE_PREFIX="erp"
STORAGE_ENDPOINT=""          # p. ej. https://<proyecto>.supabase.co/storage/v1/s3
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Sólo con STORAGE_BACKEND=local. Por defecto, el mismo raíz que UPLOAD_PATH.
STORAGE_LOCAL_ROOT="./data/storage"
#
# NOTA · los nombres de arriba son los CANÓNICOS. La ola B se escribió contra
# `STORAGE_DRIVER` y `STORAGE_S3_*`, que se siguen leyendo como alias para no
# romper un entorno ya configurado. **No mezcle los dos juegos en el mismo
# fichero**: así es como se despliega una instalación que cree tener S3 y escribe
# en `/tmp`.
#
# Los ficheros subidos ANTES de E11 sólo están en disco: súbalos con
#   npx tsx scripts/migrate-uploads-to-storage.ts --apply
# que es IDEMPOTENTE y NO sube un fichero cuyo sha256 discrepe del registrado.
# Runbook completo: docs/deploy/e11-plataforma.md

# Sello de versión del despliegue; lo publica `/api/health` (§7.3).
GIT_SHA=""

# ── Stripe en pruebas ────────────────────────────────────────────────────────
# NO hacen falta claves reales para desarrollar ni para los tests: la suite
# firma sus propios eventos con `STRIPE_WEBHOOK_SECRET` mediante
# `stripe.webhooks.generateTestHeaderString`, de modo que la verificación de
# firma se ejercita de verdad sin tocar Stripe. Con `STRIPE_SECRET_KEY` vacío,
# `/api/stripe/*` responde 501 («facturación no disponible en esta instalación»)
# y `/settings/subscription` enseña el uso igual.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_test_secret_para_la_suite"
