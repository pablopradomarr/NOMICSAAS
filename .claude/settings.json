{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test*)",
      "Bash(npm run build)",
      "Bash(npx prisma *)",
      "Bash(npx tsx *)",
      "Bash(npx vitest *)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(rm -rf *)",
      "Bash(npx prisma db push*)",
      "Bash(npx prisma migrate reset*)",
      "Edit(docs/adr/*)",
      "Edit(tests/fixtures/*)",
      "Edit(docs/spec/SPEC-FIABILIDAD.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *lib/ledger/*|*lib/analytics/*) if grep -nE 'Date\\.now\\(\\)|new Date\\(\\)|from \"@/lib/db\"|prisma\\.|fetch\\(' \"$f\" >/dev/null 2>&1; then echo \"⚠ Motor contable debe ser puro (sin Date.now/new Date()/prisma/fetch): $f\" >&2; exit 2; fi;; esac; exit 0"
          }
        ]
      }
    ]
  }
}
