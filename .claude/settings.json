{
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(npx prisma generate:*)",
      "Bash(npx tsx:*)",
      "Bash(npx vitest:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Bash(npx prisma db push:*)",
      "Bash(npx prisma migrate reset:*)",
      "Edit(docs/spec/SPEC-FIABILIDAD.md)",
      "Write(docs/spec/SPEC-FIABILIDAD.md)",
      "Edit(.claude/agents/auditor-fiabilidad.md)",
      "Write(.claude/agents/auditor-fiabilidad.md)",
      "Edit(.claude/skills/fiabilidad/SKILL.md)",
      "Write(.claude/skills/fiabilidad/SKILL.md)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard.sh"
          }
        ]
      }
    ]
  }
}
